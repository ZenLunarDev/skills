CC = gcc
CFLAGS = -Wall -Wextra -std=c11 -O2 -Iinclude
LDFLAGS =
SRC_DIR = src
INCLUDE_DIR = include
TEST_DIR = tests
BIN_DIR = bin
BIN = $(BIN_DIR)/language
TEST_BIN = $(BIN_DIR)/language_test

SOURCES = $(wildcard $(SRC_DIR)/*.c)
HEADERS = $(wildcard $(INCLUDE_DIR)/*.h)
TEST_SOURCES = $(wildcard $(TEST_DIR)/*.c)

.PHONY: all clean debug release test format

all: release

debug: CFLAGS += -g3 -O0 -DDEBUG -fsanitize=address
debug: $(BIN)

release: CFLAGS += -O2 -DNDEBUG
release: $(BIN)

$(BIN_DIR):
	@mkdir -p $(BIN_DIR)

$(BIN): $(SOURCES) $(HEADERS) | $(BIN_DIR)
	$(CC) $(CFLAGS) -o $@ $^ $(LDFLAGS)
	@echo "Build complete: $(BIN)"

test: $(SOURCES) $(TEST_SOURCES) $(HEADERS) | $(BIN_DIR)
	$(CC) $(CFLAGS) -o $(TEST_BIN) $(SOURCES) $(TEST_SOURCES) $(LDFLAGS)
	@echo "Running tests..."
	@./$(TEST_BIN)

format:
	@if command -v clang-format >/dev/null 2>&1; then \
		clang-format -i $(SOURCES) $(HEADERS) $(TEST_SOURCES); \
		echo "Formatted source files"; \
	else \
		echo "clang-format not found"; \
	fi

clean:
	rm -rf $(BIN_DIR)

.PHONY: help
help:
	@echo "Available targets:"
	@echo "  make        - Build release binary (default)"
	@echo "  make debug  - Build debug binary with ASan"
	@echo "  make test   - Build and run tests"
	@echo "  make format - Format source with clang-format"
	@echo "  make clean  - Remove build artifacts"
	@echo "  make help   - Show this help"
